# Local development only. These are public disposable development credentials, not secrets.
# The application reads process variables; it does not implicitly read this file.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://sec_research:sec_research_dev@127.0.0.1:5432/sec_research
ARTIFACT_ROOT=.runtime/artifacts
LOG_LEVEL=INFO
DB_CONNECT_TIMEOUT=3
DB_POOL_SIZE=5

# Phase 2: configure a real organization/project and contact before live SEC access.
# Deliberately empty: never use an invented contact for live ingestion.
SEC_USER_AGENT=
SEC_REQUESTS_PER_SECOND=5
SEC_TIMEOUT_SECONDS=15
SEC_DEADLINE_SECONDS=120
SEC_MAX_ATTEMPTS=4
SEC_MAX_BYTES=33554432
